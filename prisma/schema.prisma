generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Ticket {
  id Int @default(autoincrement()) @id
  title String 
  description String 
  sector Sector
  priority Priority
  status Status?
  createdAt DateTime @default(now())
}

enum Sector {
  TI
  RH
  PRODUCAO
  LOGISTICA
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
}

enum Status {
  ABERTO
  EM_ANDAMENTO
  FINALIZADO
}

